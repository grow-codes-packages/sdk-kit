{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "packages": {
    "typescript": {
      "release-type": "node",
      "component": "typescript",
      "package-name": "@grow-codes/__KEY__",
      "initial-version": "__VERSION__",
      "extra-files": ["src/core/version.ts"]
    },
    "rust": {
      "release-type": "rust",
      "component": "rust",
      "package-name": "grow-__KEY__",
      "initial-version": "__VERSION__"
    },
    "go": {
      "release-type": "go",
      "component": "go",
      "package-name": "github.com/grow-codes-packages/__KEY__/go",
      "tag-separator": "/",
      "include-v-in-tag": true,
      "initial-version": "__VERSION__",
      "extra-files": ["version.go"]
    },
    "python": {
      "release-type": "python",
      "component": "python",
      "package-name": "grow-__KEY__",
      "initial-version": "__VERSION__",
      "extra-files": ["src/grow___KEY_SNAKE__/_version.py"]
    },
    "java": {
      "release-type": "java",
      "component": "java",
      "package-name": "codes.grow.packages:__KEY__",
      "initial-version": "__VERSION__",
      "skip-snapshot": true,
      "extra-files": ["pom.xml"]
    }
  }
}
