{
  "id": "secrets.roundtrip",
  "category": "secrets",
  "description": "set -> get -> typed getters -> exists -> metadata -> delete -> get returns null",
  "requires": ["write", "delete"],
  "steps": [
    { "op": "set", "args": { "name": "${prefix}alpha", "value": "s3cr3t-${run}" }, "save": "v1" },
    { "op": "get", "args": { "name": "${prefix}alpha" }, "expect": { "reveal": "s3cr3t-${run}" } },
    { "op": "getString", "args": { "name": "${prefix}alpha" }, "expect": { "equals": "s3cr3t-${run}" } },
    { "op": "exists", "args": { "name": "${prefix}alpha" }, "expect": { "true": true } },
    { "op": "metadata", "args": { "name": "${prefix}alpha" }, "expect": { "notNull": true } },
    { "op": "set", "args": { "name": "${prefix}num", "value": "42" } },
    { "op": "getNumber", "args": { "name": "${prefix}num" }, "expect": { "equals": 42 } },
    { "op": "set", "args": { "name": "${prefix}flag", "value": "yes" } },
    { "op": "getBool", "args": { "name": "${prefix}flag" }, "expect": { "equals": true } },
    { "op": "set", "args": { "name": "${prefix}obj", "value": { "a": 1, "b": "two" } } },
    { "op": "getJson", "args": { "name": "${prefix}obj" }, "expect": { "equals": { "a": 1, "b": "two" } } },
    { "op": "getNumber", "args": { "name": "${prefix}alpha" }, "expect": { "error": "VALIDATION" } },
    { "op": "delete", "args": { "name": "${prefix}alpha" } },
    { "op": "get", "args": { "name": "${prefix}alpha" }, "expect": { "null": true } },
    { "op": "exists", "args": { "name": "${prefix}alpha" }, "expect": { "false": true } },
    { "op": "delete", "args": { "name": "${prefix}num" } },
    { "op": "delete", "args": { "name": "${prefix}flag" } },
    { "op": "delete", "args": { "name": "${prefix}obj" } }
  ]
}
