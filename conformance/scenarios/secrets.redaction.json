{
  "id": "secrets.redaction",
  "category": "secrets",
  "description": "a secret value never appears in toString/debug output",
  "requires": ["write", "delete"],
  "steps": [
    { "op": "set", "args": { "name": "${prefix}hidden", "value": "do-not-print-${run}" } },
    { "op": "get", "args": { "name": "${prefix}hidden" }, "expect": { "stringForm": { "notContains": "do-not-print-${run}" } } },
    { "op": "delete", "args": { "name": "${prefix}hidden" } }
  ]
}
