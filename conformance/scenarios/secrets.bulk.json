{
  "id": "secrets.bulk",
  "category": "secrets",
  "description": "getMany, getAll, list (sorted) and loadEnv over a prefix",
  "requires": ["write", "delete"],
  "steps": [
    { "op": "set", "args": { "name": "${prefix}one", "value": "1-${run}" } },
    { "op": "set", "args": { "name": "${prefix}two", "value": "2-${run}" } },
    { "op": "set", "args": { "name": "${prefix}three", "value": "3-${run}" } },
    { "op": "getMany", "args": { "names": ["${prefix}one", "${prefix}two", "${prefix}nope"] }, "expect": { "count": 2 } },
    { "op": "getAll", "args": { "path": "${prefix}" }, "expect": { "count": 3 } },
    { "op": "list", "args": { "prefix": "${prefix}" }, "expect": { "count": 3, "sorted": true } },
    { "op": "loadEnv", "args": { "path": "${prefix}", "prefix": "GROWCONF_${run}_" }, "expect": { "count": 3 } },
    { "op": "delete", "args": { "name": "${prefix}one" } },
    { "op": "delete", "args": { "name": "${prefix}two" } },
    { "op": "delete", "args": { "name": "${prefix}three" } }
  ]
}
