{
  "id": "secrets.missing",
  "category": "secrets",
  "description": "missing secrets: get/metadata return null, require and delete raise NOT_FOUND",
  "requires": [],
  "steps": [
    { "op": "get", "args": { "name": "${prefix}missing" }, "expect": { "null": true } },
    { "op": "metadata", "args": { "name": "${prefix}missing" }, "expect": { "null": true } },
    { "op": "require", "args": { "name": "${prefix}missing" }, "expect": { "error": "NOT_FOUND" } },
    { "op": "exists", "args": { "name": "${prefix}missing" }, "expect": { "false": true } },
    { "op": "delete", "args": { "name": "${prefix}missing" }, "requires": ["delete"], "expect": { "error": "NOT_FOUND" } }
  ]
}
